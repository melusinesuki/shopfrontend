<view class="order-page">
  <view class="page-head">
    <view class="page-title">我的订单</view>
    <view class="page-subtitle">查看订单状态、商品快照和支付金额</view>
  </view>

  <view wx:if="{{orderList.length === 0}}" class="empty-card">
    <view class="empty-title">暂无订单</view>
    <view class="empty-desc">下单后可以在这里查看订单记录</view>
  </view>

  <view class="order-list" wx:else>
    <view class="order-card" wx:for="{{orderList}}" wx:key="longId">
      <view class="order-head">
        <view class="order-code">订单号 {{item.strOrderCode}}</view>
        <view class="order-status">{{item.statusText}}</view>
      </view>
      <view class="order-time">{{item.createdTimeText}}</view>

      <view class="product-row" wx:for="{{item.productList}}" wx:for-item="productItem" wx:key="longProductId">
        <image class="product-image" src="{{productItem.productBean.strSurface}}" mode="aspectFill"></image>
        <view class="product-main">
          <view class="product-title">{{productItem.productBean.strTitle}}</view>
          <view class="product-use">{{productItem.productBean.strUse}}</view>
          <view class="product-bottom">
            <view class="product-price">¥{{productItem.productBean.intPrice / 100}}</view>
            <view class="product-num">x{{productItem.intNum}}</view>
          </view>
        </view>
      </view>

      <view class="order-summary">
        <text>共 {{item.productCount}} 件</text>
        <text>实付 <text class="pay-price">¥{{item.intPayPrice / 100}}</text></text>
      </view>
    </view>
  </view>
</view>
