<view class="address-page">
  <view class="page-head">
    <view>
      <view class="page-title">收货地址</view>
      <view class="page-subtitle">选择常用地址，确认订单时自动带入</view>
    </view>
    <navigator class="add-button" url="/pages/mine/address-edit/index">新增</navigator>
  </view>

  <view class="address-list">
    <view class="address-card address-card-active" wx:for="{{addressList}}" wx:key="longId">
      <view class="card-top">
        <view class="receiver">
          <text class="receiver-name">{{item.strNickname}}</text>
          <text class="receiver-phone">{{item.strCellphone}}</text>
        </view>
        <view class="default-tag" wx:if="{{item.intIsDefault==1}}">默认</view>
      </view>
      <view class="address-text">{{item.strProvinces}} {{item.strCity}} {{item.strDistrict}} {{item.strDetailAddress}}</view>
      <view class="card-bottom">
        <view class="select-state" bind:tap="setDefault" data-longid="{{item.longId}}">
          <view class="radio-dot {{item.intIsDefault==1?'radio-dot-active':''}}"></view>
          <text>设为默认</text>
        </view>
        <view class="card-actions">
          <text bind:tap="toEdit" data-longid="{{item.longId}}">编辑</text>
          <text bind:tap="remove" data-longid="{{item.longId}}">删除</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-placeholder"></view>
</view>
