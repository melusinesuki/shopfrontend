<view wx:if="{{productDetail.longId}}">

  <!-- 商品图片 -->
  <image class="product-image" src="{{productDetail.strSurface}}" mode="aspectFill"></image>

  <!-- 价格信息区 -->
  <view class="price-panel">
    <view class="price-main">
      <text class="price-symbol">¥</text>
      <text class="price-value">{{productDetail.intPrice / 100}}</text>
    </view>
    <text class="price-tag">已售{{productDetail.intSales || 0}}件</text>
  </view>

  <!-- 商品信息 -->
  <view class="info-panel">
    <view class="product-title">{{productDetail.strTitle}}</view>
    <view class="product-meta">
      <text>商品编号：{{productDetail.strNo}}</text>
      <text>月销 {{productDetail.intSales || 0}}</text>
    </view>
    <view class="delivery-bar">
      <text class="delivery-item">🚚 快递：免运费</text>
      <text class="delivery-item">📍 上海发货</text>
    </view>
  </view>

  <!-- 商品详情 -->
  <view class="detail-panel">
    <view class="detail-title">商品详情</view>
    <view class="detail-content">{{productDetail.strUse}}</view>
  </view>

  <view class="bottom-placeholder"></view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bar-cart" bind:tap="goToCart">
      <text class="bar-cart-icon">🛒</text>
      <text class="bar-cart-label">购物车</text>
    </view>
    <view class="bar-actions">
      <button class="btn-cart" bind:tap="addToCart">加入购物车</button>
      <button class="btn-buy" bind:tap="buyNow">立即购买</button>
    </view>
  </view>

</view>

<view class="loading" wx:if="{{!productDetail.longId && loading}}">
  <text>加载中...</text>
</view>
