.address-page {
  min-height: 100vh;
  padding: 34rpx 28rpx 54rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.address-card {
  padding: 28rpx;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.address-card-active {
  border-color: #ff4757;
  box-shadow: 0 4rpx 20rpx rgba(255, 71, 87, 0.14);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.receiver {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 14rpx;
  min-width: 0;
}

.receiver-name {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 42rpx;
  color: #333333;
}

.receiver-phone {
  font-size: 25rpx;
  line-height: 34rpx;
  color: #999999;
}

.default-tag {
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 28rpx;
  color: #ff4757;
  background: #fff0f0;
}

.address-text {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #333333;
}

.bottom-placeholder {
  height: 24rpx;
}
