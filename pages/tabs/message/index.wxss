.message-page {
  min-height: 100vh;
  padding: 34rpx 28rpx 54rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.message-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 26rpx;
}

.head-left {
  flex: 1;
}

.page-title {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 54rpx;
  color: #333;
}

.page-subtitle {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  color: #999;
}

.unread-pill {
  flex-shrink: 0;
  margin-top: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 30rpx;
  color: #ff4757;
  background: #ffe0e3;
}

.empty-card,
.message-card {
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.empty-card {
  padding: 78rpx 34rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 22rpx;
  border-radius: 32rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  background: #ff4757;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #333;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  color: #999;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.message-card {
  padding: 28rpx;
  border: 2rpx solid transparent;
}

.message-unread {
  border-color: #ffcccc;
}

.message-read {
  opacity: 0.72;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.message-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.unread-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4757;
}

.message-title {
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 42rpx;
  color: #333;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
  color: #ff4757;
  background: #fff0f0;
}

.message-content {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 42rpx;
  color: #666;
}

.card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.message-time {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #999;
}

.read-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 150rpx;
  height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  font-weight: 700;
  color: #ffffff;
  background: #ff4757;
}

.read-button::after {
  border: 0;
}

.read-state {
  flex-shrink: 0;
  font-size: 25rpx;
  line-height: 34rpx;
  color: #999;
}
