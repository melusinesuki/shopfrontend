<view class="message-page">
  <view class="message-head">
    <view class="head-left">
      <view class="page-title">消息通知</view>
      <view class="page-subtitle">订单、物流和系统消息都会在这里展示</view>
    </view>
    <view class="unread-pill">消息 {{messageList.length}}</view>
  </view>

  <view wx:if="{{messageList.length === 0}}" class="empty-card">
    <view class="empty-icon">信</view>
    <view class="empty-title">暂无消息</view>
    <view class="empty-desc">有新的订单或物流通知时会显示在这里</view>
  </view>

  <view wx:else class="message-list">
    <view class="message-card {{item.intStatus === 1 ? 'message-read' : 'message-unread'}}" wx:for="{{messageList}}" wx:key="longId">
      <view class="card-head">
        <view class="message-title-wrap">
          <view wx:if="{{item.intStatus === 0}}" class="unread-dot"></view>
          <view class="message-title">{{item.strTitle}}</view>
        </view>
        <view class="message-tag">{{item.bizTypeName}}</view>
      </view>

      <view class="message-content">{{item.strContent}}</view>

      <view class="card-bottom">
        <view class="message-time">{{item.createdTimeStr}}</view>
        <button wx:if="{{item.intStatus === 0}}" class="read-button" bind:tap="read" data-id="{{item.longId}}">标为已读</button>
        <view wx:else class="read-state">已读</view>
      </view>
    </view>
  </view>
</view>
