<view class="mine-page">
  <!-- 已登录 -->
  <view class="mine-header" wx:if="{{isLogin}}">
    <image class="avatar" src="{{memberInfo.strAvatar}}" mode="aspectFill" />
    <text class="nickname">{{memberInfo.strNickname}}</text>
  </view>

  <!-- 未登录 -->
  <view class="mine-header" wx:else>
    <view class="avatar-placeholder">👤</view>
    <text class="header-tip">登录后查看订单和收藏</text>
    <button class="login-btn" bind:tap="toLogin">登录</button>
  </view>

  <!-- 菜单 -->
  <view class="menu-list" wx:if="{{isLogin}}">
    <view class="menu-item" bind:tap="toOrderList">
      <text>我的订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="toFavorites">
      <text>我的收藏</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="toAddressList">
      <text>收货地址</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="toSettings">
      <text>设置</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="logout-wrap" wx:if="{{isLogin}}">
    <button class="logout-btn" bind:tap="logout">退出登录</button>
  </view>
</view>
