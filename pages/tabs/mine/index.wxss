.mine-page {
  min-height: 100vh;
  background: #f5f5f5;
}
.mine-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  background: #ff4757;
}
.avatar-placeholder {
  font-size: 100rpx;
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  background: rgba(255,255,255,0.3);
  border-radius: 50%;
  margin-bottom: 20rpx;
}
.header-tip {
  color: rgba(255,255,255,0.9);
  font-size: 28rpx;
  margin-bottom: 30rpx;
}
.login-btn {
  width: 300rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  color: #ff4757;
  background: #fff;
  border: none;
  border-radius: 36rpx;
}
.menu-list {
  background: #fff;
  margin: 20rpx 28rpx;
  border-radius: 16rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.menu-item .arrow {
  margin-left: auto;
  color: #ccc;
}
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
  border: 4rpx solid rgba(255,255,255,0.5);
}
.nickname {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}
.logout-wrap {
  padding: 40rpx 28rpx;
}
.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #999;
  background: #fff;
  border: none;
  border-radius: 16rpx;
}
