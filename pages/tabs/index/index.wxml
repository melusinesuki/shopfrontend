<!-- 轮播图 -->
<swiper class="banner" indicator-dots indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#ff4757" autoplay circular>
  <swiper-item wx:for="{{banners}}" wx:key="*this">
    <view class="banner-slide" style="background-color: {{item.bg}}">
      <view class="banner-text">
        <view class="banner-title">{{item.title}}</view>
        <view class="banner-desc">{{item.desc}}</view>
      </view>
    </view>
  </swiper-item>
</swiper>

<!-- 分类入口 -->
<view class="category-bar">
  <view class="category-item" wx:for="{{categories}}" wx:key="name" bind:tap="toCategory" data-name="{{item.name}}">
    <text class="category-icon">{{item.icon}}</text>
    <text class="category-name">{{item.name}}</text>
  </view>
</view>

<!-- 热门推荐 -->
<view class="section-header">
  <text class="section-title">热门推荐</text>
  <text class="section-more" bind:tap="toShop">查看更多 ›</text>
</view>

<!-- 商品网格 -->
<view class="product-grid">
  <view class="product-card" wx:for="{{products}}" wx:key="longId" bind:tap="toDetail" data-id="{{item.longId}}">
    <image class="card-image" src="{{item.strSurface}}" mode="aspectFill" lazy-load></image>
    <view class="card-info">
      <view class="card-title">{{item.strTitle}}</view>
      <view class="card-bottom">
        <view class="card-price">
          <text class="price-symbol">¥</text>
          <text class="price-value">{{item.intPrice / 100}}</text>
        </view>
        <view class="card-cart-btn" catch:tap="addToCart" data-id="{{item.longId}}">
          <text>🛒</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 空状态 -->
<view class="empty" wx:if="{{products.length === 0 && !loading}}">
  <text class="empty-icon">📦</text>
  <text class="empty-text">暂无商品</text>
</view>
