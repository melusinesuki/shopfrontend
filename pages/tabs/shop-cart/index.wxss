.cart-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 170rpx;
  box-sizing: border-box;
  background: var(--bg);
}

.cart-header {
  margin-bottom: 24rpx;
}

.cart-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
}

.cart-subtitle {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--text-light);
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cart-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--white);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-check {
  flex-shrink: 0;
}

.goods-image {
  display: block;
  flex-shrink: 0;
  width: 168rpx;
  height: 168rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: var(--text);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-desc {
  display: -webkit-box;
  overflow: hidden;
  height: 64rpx;
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 32rpx;
  color: var(--text-light);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
}

.qty-stepper {
  display: flex;
  align-items: center;
  overflow: hidden;
  border-radius: 999rpx;
  border: 1rpx solid #e8e8e8;
}

.qty-btn,
.qty-num {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 50rpx;
  min-width: 52rpx;
  font-size: 26rpx;
  color: var(--text);
}

.qty-btn {
  background: #f5f5f5;
}

.qty-num {
  min-width: 58rpx;
  font-weight: 600;
  background: var(--white);
}

.cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-light);
}

.cart-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--white);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.select-all {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text);
}

.bar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.total-box {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: 22rpx;
  color: var(--text-light);
}

.total-price {
  margin-top: 2rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary);
}

.checkout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: var(--primary);
  border: none;
}

.checkout-btn::after {
  border: 0;
}
